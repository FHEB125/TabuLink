DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
SQLITE_DB=db.sqlite3
# For PostgreSQL use DB_ENGINE=postgresql and set:
# DB_NAME=tabulink_db
# DB_USER=tabulink_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
TABULINK_BACKUP_ROOT=backups

# Media storage (optional)
# Set USE_S3_MEDIA=1 and the credentials below for persistent media on Render.
# Works with any S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces). See RENDER_DEPLOY.md for setup + one-time copy of
# existing files (TABULINK_SYNC_MEDIA=1 python manage.py sync_media).
USE_S3_MEDIA=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=
