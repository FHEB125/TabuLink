# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Django ---
# Local SQLite database + its manual backups. Production uses Postgres.
db.sqlite3
db.sqlite3.*
*.bak

# --- Collected static (regenerated by `collectstatic` on every build) ---
staticfiles/

# --- Uploaded media ---
# On Render these live in the external bucket (see RENDER_DEPLOY.md), not git.
# Already-committed files stay tracked; this only stops new uploads being added.
media/

# --- Backups / logs / scratch ---
backups/
*.log
current_test_output.log
full_test_output.log
full_test.txt

# --- Ad-hoc dev / one-off scripts (not part of the application) ---
# Inspected: none are imported, executed by the app/tests, or used by the
# build/deploy. They are local debugging helpers / captured output.
check_ai.py
check_simple.py
fix_patch.py
patch_coordinator.py
patch_views.py
temp_fix.py
temp_settings.py
test_output.txt
